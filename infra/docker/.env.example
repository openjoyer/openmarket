# Copy to .env and override for non-dev environments. .env is gitignored.
# Compose substitutes ${VAR:-default}; if unset, the dev defaults are used.

# Postgres superuser
# (SPRING_DATASOURCE_USERNAME/PASSWORD)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Grafana admin credentials (observability stack).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
